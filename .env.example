PORT=4310
HOST=0.0.0.0
PUBLIC_URL=http://localhost:5173
CONTROL_PLANE_HOSTNAME=
DATA_DIR=./data
DEPLOY_DRY_RUN=false
DEPLOY_HOST_PORT_START=4100
DEPLOY_HOST_PORT_END=4999
# Brand / URLs / mail. Keep these in env so the domain and from-address can be
# swapped without touching code. Legacy ORIZONCP_* names still work as fallbacks.
APP_NAME=orizonCP
APP_URL=https://cp.orzn.io
BASE_DOMAIN=cp.orzn.io
MAIL_FROM_ADDRESS=no-reply@orzn.io
MAIL_FROM_NAME=orizonCP
SUPPORT_EMAIL=support@orzn.io
ORIZONCP_RUNTIME_NETWORK=orizoncp-runtime
BUILDKIT_HOST=tcp://127.0.0.1:1234
CADDY_CONFIG_PATH=./data/Caddyfile
CADDY_RELOAD_CMD=caddy reload --config ./data/Caddyfile
IMAGE_REPO=ghcr.io/learnwithrichuncle/orizoncp
ORIZONCP_UPDATE_REPO_URL=https://github.com/learnwithrichuncle/orizoncp.git
ORIZONCP_UPDATE_BRANCH=main
# Optional. Example: systemctl restart orizoncp
ORIZONCP_UPDATE_RESTART_CMD=
# Docker image installs use this commit to compare pending updates.
ORIZONCP_COMMIT_SHA=
# Optional. Defaults to a self-updater container using /opt/orizoncp.
ORIZONCP_IMAGE=ghcr.io/learnwithrichuncle/orizoncp:latest
ORIZONCP_INSTALL_DIR=/opt/orizoncp
ORIZONCP_IMAGE_UPDATE_CMD=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Temporary fallback only. Prefer the GitHub App settings above.
# GITHUB_ACCESS_TOKEN=